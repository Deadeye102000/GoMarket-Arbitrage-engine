# ──────────────────────────────────────────────────────────────────────────────
# GoMarket Arbitrage Engine — Environment Configuration
# Copy to .env: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_DSN=postgres://gomarket:gomarket@localhost:5432/gomarket?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ── Kafka / Redpanda ──────────────────────────────────────────────────────────
# Use port 19092 (external) when running locally; 9092 (internal) inside Docker
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=market.ticks
# Set to false to skip Kafka and use in-process buffered channels (dev mode)
KAFKA_ENABLED=true

# ── LLM — Ollama (100% free, runs locally) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
# Change to "tinyllama" if your machine has < 8 GB RAM (600 MB vs 2 GB download)
OLLAMA_MODEL=llama3.2
LLM_ENABLED=true
# Analyze 1 out of every N signals (reduces LLM load)
LLM_SAMPLE_RATE=10

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
WORKER_COUNT=10
CHANNEL_SIZE=500
BATCH_SIZE=100
FLUSH_INTERVAL=500ms
MIN_SPREAD_PCT=1.0

# ── HTTP Server ───────────────────────────────────────────────────────────────
PORT=8080

# ── Observability ─────────────────────────────────────────────────────────────
# "stdout" prints OTel spans as JSON to stdout (dev).
# Set to an OTLP endpoint (e.g. http://collector:4317) for production.
OTEL_ENDPOINT=stdout
